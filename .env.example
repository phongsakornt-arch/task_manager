# ── Frontend (Vite, bundled into the client — never put secrets here) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Not currently read anywhere in src/ — kept for legacy/local compatibility. Safe to remove if unused.
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-name
# Web Push public VAPID key (safe to expose — pairs with VAPID_PRIVATE_KEY set as an edge function secret)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ── Local admin/migration scripts only (never exposed to the client) ──
# Used by ad-hoc sync/migration scripts run with `node scripts/*.mjs` — full DB access, keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase Edge Function secrets ──
# These are NOT read from this file. Set them on the deployed project with:
#   npx supabase secrets set NAME=value --linked
# Listed here so local `supabase functions serve` and new deploys know what's needed.
# Set automatically by Supabase, do not set manually:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (see _shared/auth.ts)
#
# Google Drive bridge (drive-bridge function) — see supabase/functions/README.md:
#   DRIVE_BRIDGE_URL=
#   DRIVE_BRIDGE_SECRET=
#
# Google Calendar sync (sync-task-calendar, resync-task-calendar, app-meta, system-health):
#   GOOGLE_CALENDAR_ID=
#   GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Email (send-task-email, daily-task-reminder, app-meta, system-health):
#   RESEND_API_KEY=
#   TASK_EMAIL_FROM=
#
# AI features (ai-task-parse, ai-approval, ai-todo-split, ai-annual-report,
# ai-member-search, extract-doc-info, extract-receipt) — each tries these in
# order and uses the first one configured:
#   GROQ_API_KEY=
#   GEMINI_API_KEY=
#   OPENAI_API_KEY=
#
# Approval public links (approval-links):
#   PUBLIC_SITE_URL=http://localhost:5173
#
# Scheduled jobs (daily-task-reminder) — shared secret checked against the cron trigger:
#   CRON_SECRET=
#
# Web Push (send-push, daily-task-reminder) — generate with `npx web-push generate-vapid-keys`:
#   VAPID_PUBLIC_KEY=        (also set as VITE_VAPID_PUBLIC_KEY above/in Vercel)
#   VAPID_PRIVATE_KEY=
#   VAPID_SUBJECT=mailto:you@example.com
#
# Misc (app-meta):
#   APP_ENV=production
